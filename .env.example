# Modelo de configuração do Portal de Fornecedores Queiroz
# Preencha com valores reais apenas no ambiente seguro de execução.
# Nunca coloque credenciais reais neste arquivo.

PGHOST=seu-host-do-banco
PGPORT=5432
PGDATABASE=nome_do_banco
PGUSER=usuario_do_banco
PGPASSWORD=substitua_por_uma_senha_segura

SESSION_SECRET=substitua_por_um_segredo_aleatorio_com_pelo_menos_32_caracteres

# Usadas apenas em tarefas administrativas ou de teste, não necessariamente na aplicação publicada.
PORTAL_TEST_PASSWORD=
PORTAL_ADMIN_USER=
PORTAL_ADMIN_PASSWORD=
